---
import copy from '../data/landing.json';
import { blogCopy, languageNames, languageTags, locales, localizePath, type Locale } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
const t = copy[lang];
const home = localizePath('/', lang);
const blog = /\/blog(?:\/|$)/.test(Astro.url.pathname);
const translatedPath = blog || /^\/(?:(?:en|zh-cn)\/)?$/.test(Astro.url.pathname) ? Astro.url.pathname : '/';
const languageLabel = lang === 'en' ? 'Choose language' : lang === 'zh' ? '切換語言' : '切换语言';
const shortLanguage = { zh: '繁中', en: 'EN', 'zh-cn': '简中' } as const;
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-lime focus:px-4 focus:py-3 focus:text-ink">{lang === 'zh' ? '跳到主要內容' : lang === 'zh-cn' ? '跳到主要内容' : 'Skip to content'}</a>
<header class="z-40 border-b border-line bg-white md:sticky md:top-0">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3.5">
    <a href={home} aria-label="engawa" class="inline-flex min-h-11 items-center rounded-lg"><img src="/brand/wordmark.svg" alt="engawa" width="144" height="26" class="h-[26px] w-auto" /></a>
    <nav aria-label={t.nav.label} class="flex flex-wrap items-center gap-x-4 text-sm text-body md:gap-x-[18px]">
      {(['tour', 'why', 'start', 'k8s'] as const).map(key => <a class="inline-flex min-h-11 items-center rounded-md hover:text-ink hover:underline underline-offset-4" href={`${home}#${key}`}>{t.nav[key]}</a>)}
      <a href={localizePath('/blog/', lang)} aria-current={blog ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center rounded-md underline-offset-4 hover:underline', { 'font-semibold underline text-ink': blog }]}>{blogCopy[lang].title}</a>
      <a class="inline-flex min-h-11 items-center rounded-md hover:underline underline-offset-4" href="https://github.com/engawahq">GitHub</a>
      <details class="language-switcher" data-language-switcher>
        <summary aria-label={`${languageLabel}: ${languageNames[lang]}`}>
          <Icon name="globe" />
          <span lang={languageTags[lang]}>{shortLanguage[lang]}</span>
          <span class="language-caret"><Icon name="caret-down" /></span>
        </summary>
        <ul class="language-options" aria-label={languageLabel}>
          {locales.map(locale => <li><a href={localizePath(translatedPath, locale)} lang={languageTags[locale]} hreflang={languageTags[locale]} aria-current={lang === locale ? 'page' : undefined}>
            <span>{languageNames[locale]}</span>
            {lang === locale && <span class="language-selected"><Icon name="check" /></span>}
          </a></li>)}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .language-switcher { position: relative; margin-inline-start: auto; color: var(--color-ink); }
  .language-switcher summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    cursor: pointer;
    list-style: none;
    font-size: 0.8125rem;
    font-weight: 500;
    touch-action: manipulation;
    background: white;
  }
  .language-switcher summary::-webkit-details-marker { display: none; }
  .language-switcher summary:hover,
  .language-switcher[open] summary { background: var(--color-surface); border-color: var(--color-ink); }
  .language-switcher summary:focus-visible,
  .language-options a:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }
  .language-caret { display: flex; color: var(--color-muted); }
  .language-switcher[open] .language-caret { transform: rotate(180deg); }
  .language-options {
    position: absolute;
    z-index: 50;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    width: 11rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: white;
    box-shadow: 0 8px 24px rgb(37 51 38 / 10%);
  }
  .language-options a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .language-options a:hover { background: var(--color-surface); }
  .language-options a[aria-current="page"] { background: var(--color-brand-soft); font-weight: 600; }
  .language-selected { display: flex; }
</style>

<script>
  const switcher = document.querySelector<HTMLDetailsElement>('[data-language-switcher]');
  if (switcher) {
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !switcher.contains(event.target)) switcher.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && switcher.open) {
        switcher.open = false;
        switcher.querySelector('summary')?.focus();
      }
    });
    switcher.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !switcher.contains(event.relatedTarget)) switcher.open = false;
    });
  }
</script>
