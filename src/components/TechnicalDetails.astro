---
import Icon from './Icon.astro';
import type landing from '../data/landing.json';
interface Props {
	copy: (typeof landing.en)['k8s'];
}

const { copy } = Astro.props;

const MAP = [
	{
		yaml: ['apiVersion: v1', 'kind: Namespace', 'metadata:', '  name: my-shop'],
		hl: [3],
		val: 'my-shop',
		secret: false,
	},
	{
		yaml: [
			'apiVersion: apps/v1',
			'kind: Deployment',
			'metadata:',
			'  name: web',
			'  namespace: my-shop',
			'spec:',
			'  replicas: 2',
		],
		hl: [3, 4],
		val: 'web',
		secret: false,
	},
	{
		yaml: [
			'kind: HTTPRoute',
			'metadata:',
			'  name: web',
			'spec:',
			'  hostnames:',
			'  - shop.example.com',
			'  rules:',
			'  - backendRefs:',
			'    - name: web',
		],
		hl: [5, 8],
		val: 'shop.example.com → web',
		secret: false,
	},
	{
		yaml: [
			'kind: Deployment  # web',
			'spec:',
			'  template:',
			'    spec:',
			'      volumes:',
			'      - persistentVolumeClaim:',
			'          claimName: uploads',
		],
		hl: [6],
		val: 'uploads',
		secret: false,
	},
	{
		yaml: [
			'kind: Deployment  # api',
			'spec:',
			'  template:',
			'    spec:',
			'      containers:',
			'      - name: api',
			'        envFrom:',
			'        - secretRef:',
			'            name: api-key',
		],
		hl: [8],
		val: 'api-key',
		secret: true,
	},
	{
		yaml: [
			'apiVersion: postgresql.cnpg.io/v1',
			'kind: Cluster',
			'metadata:',
			'  name: db',
			'spec:',
			'  instances: 1',
		],
		hl: [1, 3],
		val: 'db',
		secret: false,
	},
];

const INITIAL = 2;
const LAST_LAYER = copy.layers.length - 1;
const NODES = [
	{ lv: 'L2', name: 'engawa', min: 1 },
	{ lv: 'L3', name: 'genkan', min: 2 },
];
---

<section id="k8s" class="wrap section-space" data-tech>
	<details class="group" data-k8s>
		<summary
			class="flex cursor-pointer list-none flex-wrap items-end justify-between gap-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink [&::-webkit-details-marker]:hidden"
		>
			<div class="min-w-0 flex-[1_1_420px]">
				<div class="eyebrow"><span>06</span>{copy.eyebrow}</div>
				<h2 class="heading-lg text-ink">{copy.title}</h2>
				<p class="lede">{copy.body}</p>
			</div>
			<span
				class="button button-outline inline-flex h-11 items-center gap-2 px-5 text-[15px]"
			>
				<Icon name="caret-down" class="group-open:hidden" />
				<Icon name="caret-up" class="hidden group-open:block" />
				<span class="group-open:hidden">{copy.open}</span>
				<span class="hidden group-open:inline">{copy.close}</span>
			</span>
		</summary>

		<div class="mt-10 border-t border-line pt-2" id="k8s-more">
			<h3 class="mt-8 text-[22px] leading-snug font-semibold tracking-tight text-ink">{copy.mapTitle}</h3>
			<p class="lede">{copy.mapBody}</p>

			<div class="mt-12 flex flex-wrap items-stretch gap-5">
				<div class="min-w-0 flex-[1_1_420px] overflow-hidden rounded-2xl border border-line bg-white">
					<div class="flex items-center gap-4 border-b border-line px-4 py-3 text-xs text-muted">
						<span class="flex-1">{copy.colK}</span>
						<span>{copy.colV}</span>
					</div>
					<div>
						{
							copy.rows.map((row, i) => (
								<button
									type="button"
									class:list={[
										'map-row grid w-full min-h-[52px] cursor-pointer grid-cols-[minmax(0,1fr)_48px_max-content] items-center gap-3 border-0 border-b border-line bg-transparent px-4 py-2 text-left font-inherit text-inherit last:border-b-0 hover:bg-surface',
										i === INITIAL && 'is-on',
									]}
									data-map-btn={i}
									aria-pressed={i === INITIAL ? 'true' : 'false'}
								>
									<code class="font-mono text-[13px] break-words" translate="no">
										{row.k}
									</code>
									<span class="map-link block h-0.5 origin-left rounded-sm bg-line" aria-hidden="true"
									></span>
									<span class="text-right text-[15px] font-semibold">{row.v}</span>
								</button>
							))
						}
					</div>
				</div>

				<div
					class="flex min-w-0 flex-[1_1_380px] flex-col overflow-hidden rounded-2xl bg-ink text-[oklch(0.97_0.01_140)]"
					aria-live="polite"
				>
					<div
						class="flex min-h-11 items-center justify-between gap-3 border-b border-white/15 px-4 text-xs text-[oklch(0.86_0.02_140)]"
					>
						<span>{copy.hint}</span>
						<span class="font-mono" translate="no">my-shop.yaml</span>
					</div>
					{
						MAP.map((item, i) => (
							<div class="flex flex-1 flex-col" data-map-panel={i} hidden={i !== INITIAL}>
								<div class="min-h-[168px] overflow-x-auto py-3.5" translate="no">
									{item.yaml.map((line, j) => (
										<span
											class:list={[
												'yl block px-4 font-mono text-[13px] leading-[22px] whitespace-pre text-[oklch(0.86_0.02_140)]',
												item.hl.includes(j) &&
													'bg-lime/15 text-lime shadow-[inset_2px_0_0_#d7f593]',
											]}
										>
											{line}
										</span>
									))}
								</div>
								<div class="flex items-center gap-2 px-4 text-xs text-[oklch(0.86_0.02_140)]">
									<Icon name="arrow-down" />
									{copy.readAs}
								</div>
								<div
									class="mx-4 mt-2.5 mb-4 flex min-h-[52px] flex-wrap items-center justify-between gap-2 rounded-xl bg-white px-3.5 py-2.5 text-ink"
								>
									<span class="text-[15px] font-semibold">{copy.rows[i]?.v}</span>
									<span class="inline-flex items-center gap-2 font-mono text-[13px]" translate="no">
										{item.val}
										{item.secret && (
											<span
												class="inline-block h-3.5 w-16 rounded bg-[repeating-linear-gradient(135deg,#a3a3a3_0_1.5px,transparent_1.5px_5px)] shadow-[inset_0_0_0_1px_#e5e5e5]"
											>
												<span class="sr-only">{copy.hidden}</span>
											</span>
										)}
									</span>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<h3 class="mt-14 text-[22px] leading-snug font-semibold tracking-tight text-ink">{copy.techTitle}</h3>
			<div class="mt-9 border-t border-ink">
				{
					copy.tech.map((row) => (
						<div class="flex flex-wrap gap-x-6 gap-y-1 border-b border-line py-5 hover:bg-surface">
							<span class="min-w-0 flex-[1_1_200px] font-semibold text-ink">{row.k}</span>
							<span class="min-w-0 flex-[3_1_380px] text-body">{row.v}</span>
						</div>
					))
				}
			</div>

			<h3 class="mt-14 text-[22px] leading-snug font-semibold tracking-tight text-ink">{copy.layTitle}</h3>
			<p class="lede">{copy.layBody}</p>

			<div class="mt-12 flex flex-wrap items-start gap-x-8 gap-y-6">
				<div class="flex min-w-0 flex-[1_1_280px] flex-col gap-3.5">
					<div class="flex flex-col-reverse gap-1.5" role="group" aria-label={copy.layLabel} data-slabs>
						{
							copy.layers.map((layer, i) => (
								<button
									type="button"
									class:list={[
										'slab is-on flex w-full min-h-14 cursor-pointer items-center gap-3.5 rounded-xl border border-line bg-white px-4 text-left font-inherit',
									]}
									data-slab={i}
									aria-pressed={i === LAST_LAYER ? 'true' : 'false'}
								>
									<span class="w-[52px] shrink-0 font-mono text-[13px] font-semibold" translate="no">
										{layer.lv}
									</span>
									<span class="text-[15px] font-semibold">{layer.where}</span>
								</button>
							))
						}
					</div>
					<button type="button" class="button button-outline inline-flex h-11 items-center gap-2 self-start px-3.5 text-sm" data-build>
						<Icon name="stack" />
						{copy.layBuild}
					</button>
				</div>

				<div class="flex min-w-0 flex-[999_1_520px] flex-col gap-4">
					<div class="flex flex-wrap gap-3">
						<div class="flex min-h-[200px] min-w-0 flex-[1_1_200px] flex-col gap-2.5 rounded-2xl border border-line p-3.5">
							<div class="flex items-center justify-between gap-2 text-[13px] font-semibold">
								<span>{copy.layers[0]?.where}</span>
								<span class="font-mono text-[11px] font-normal text-muted" translate="no">L0–L1</span>
							</div>
							<div class="flex flex-wrap gap-2" translate="no">
								<span class="inline-flex min-h-8 items-center rounded-md bg-white px-2.5 font-mono text-xs shadow-[inset_0_0_0_1px_#e5e5e5]">kubeconfig</span>
								<span class="inline-flex min-h-8 items-center rounded-md bg-ink px-2.5 font-mono text-xs text-lime">engawa ui</span>
							</div>
						</div>
						<div
							class="flex min-h-[200px] min-w-0 flex-[1.6_1_300px] flex-col gap-2.5 rounded-2xl border border-line bg-surface bg-[radial-gradient(#e5e5e5_1px,transparent_1px)] bg-[length:20px_20px] p-3.5"
						>
							<div class="flex items-center justify-between gap-2 text-[13px] font-semibold">
								<span>{copy.zoneCluster}</span>
								<span class="font-mono text-[11px] font-normal text-muted" translate="no">k3s / Kubernetes</span>
							</div>
							<div class="flex flex-wrap gap-2" translate="no">
								<span class="inline-flex min-h-8 items-center rounded-md bg-white px-2.5 font-mono text-xs shadow-[inset_0_0_0_1px_#e5e5e5]">kube-apiserver</span>
								<span class="inline-flex min-h-8 items-center rounded-md bg-white px-2.5 font-mono text-xs shadow-[inset_0_0_0_1px_#e5e5e5]">web</span>
								<span class="inline-flex min-h-8 items-center rounded-md bg-white px-2.5 font-mono text-xs shadow-[inset_0_0_0_1px_#e5e5e5]">api</span>
								<span class="inline-flex min-h-8 items-center rounded-md bg-white px-2.5 font-mono text-xs shadow-[inset_0_0_0_1px_#e5e5e5]">db</span>
								<span class="inline-flex min-h-8 items-center rounded-md bg-white px-2.5 font-mono text-xs shadow-[inset_0_0_0_1px_#e5e5e5]">worker</span>
							</div>
							<div class="flex flex-wrap gap-2">
								{
									NODES.map((node) => (
										<span class="contents">
											<span
												class="node-eg is-on inline-flex min-h-8 items-center rounded-md bg-ink px-2.5 font-mono text-xs text-lime"
												data-eg={node.min}
												translate="no"
											>
												{node.name}
											</span>
											<span
												class="inline-flex min-h-8 items-center rounded-md bg-white bg-[repeating-linear-gradient(135deg,rgb(163_163_163/0.45)_0_1.5px,transparent_1.5px_5px)] px-2.5 font-mono text-xs text-muted"
												data-ghost={node.min}
												hidden
												translate="no"
											>
												<span class="rounded bg-white px-1">{node.lv}</span>
											</span>
										</span>
									))
								}
							</div>
							<p class="text-xs leading-[18px] text-muted" data-none hidden>{copy.layNone}</p>
						</div>
					</div>

					<ol class="m-0 list-none border-t border-line p-0">
						{
							copy.layers.map((layer, i) => (
								<li
									class:list={[
										'flex flex-wrap gap-x-5 gap-y-1 border-b border-line px-3 py-3.5',
										i === LAST_LAYER && 'trust-on',
									]}
									data-trust={i}
								>
									<span class="w-16 shrink-0 font-mono text-[13px] font-semibold" translate="no">{layer.lv}</span>
									<span class="min-w-0 flex-[1_1_140px] font-semibold">{layer.where}</span>
									<span class="min-w-0 flex-[3_1_300px] text-body">{layer.trusts}</span>
								</li>
							))
						}
					</ol>
					<p class="rounded-xl bg-surface px-4 py-3.5 text-[15px] leading-6 text-ink">{copy.principle}</p>
				</div>
			</div>
		</div>
	</details>
</section>

<style>
	.map-row.is-on {
		background: color-mix(in oklab, #d7f593 35%, white);
	}
	.map-row.is-on .map-link {
		transform: scaleX(1);
		background: #253326;
	}
	.map-link {
		transform: scaleX(0.4);
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.35s;
	}
	.map-row:hover .map-link {
		transform: scaleX(0.7);
	}
	.yl {
		animation: yl-in 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
	}
	.yl:nth-child(2) { animation-delay: 40ms; }
	.yl:nth-child(3) { animation-delay: 80ms; }
	.yl:nth-child(4) { animation-delay: 120ms; }
	.yl:nth-child(5) { animation-delay: 160ms; }
	.yl:nth-child(6) { animation-delay: 200ms; }
	.yl:nth-child(7) { animation-delay: 240ms; }
	.yl:nth-child(8) { animation-delay: 280ms; }
	.yl:nth-child(9) { animation-delay: 320ms; }
	@keyframes yl-in {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
	}
	.slab.is-on {
		background: #253326;
		border-color: #253326;
		color: oklch(0.97 0.01 140);
		transform: none;
	}
	.slab.is-on span:first-child {
		color: #d7f593;
	}
	.slab.is-off {
		color: #a3a3a3;
		background-image: repeating-linear-gradient(
			135deg,
			rgb(163 163 163 / 0.28) 0 1.5px,
			transparent 1.5px 6px
		);
		transform: translateY(-6px);
	}
	.slab[aria-pressed='true'] {
		box-shadow: 0 0 0 3px rgb(37 51 38 / 0.28);
	}
	.trust-on {
		background: color-mix(in oklab, #d7f593 35%, white);
		box-shadow: -12px 0 0 color-mix(in oklab, #d7f593 35%, white),
			12px 0 0 color-mix(in oklab, #d7f593 35%, white);
	}
	.node-eg.is-on {
		animation: pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
	}
	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0.92);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.yl,
		.node-eg.is-on {
			animation: none;
		}
		.slab {
			transition: none;
		}
	}
	@media (max-width: 760px) {
		.map-row {
			grid-template-columns: minmax(0, 1fr) 24px max-content;
		}
	}
</style>

<script>
	function paint(root: HTMLElement, layer: number) {
		root.querySelectorAll<HTMLButtonElement>('[data-slab]').forEach((btn) => {
			const i = Number(btn.dataset.slab);
			btn.classList.toggle('is-on', i <= layer);
			btn.classList.toggle('is-off', i > layer);
			btn.setAttribute('aria-pressed', i === layer ? 'true' : 'false');
		});
		root.querySelectorAll<HTMLElement>('[data-eg]').forEach((node) => {
			const min = Number(node.dataset.eg);
			const on = layer >= min;
			node.classList.toggle('is-on', on);
			node.hidden = !on;
		});
		root.querySelectorAll<HTMLElement>('[data-ghost]').forEach((node) => {
			const min = Number(node.dataset.ghost);
			node.hidden = layer >= min;
		});
		const note = root.querySelector<HTMLElement>('[data-none]');
		if (note) note.hidden = layer !== 0;
		root.querySelectorAll<HTMLElement>('[data-trust]').forEach((row) => {
			row.classList.toggle('trust-on', Number(row.dataset.trust) === layer);
		});
	}

	function replayYaml(panel: HTMLElement) {
		panel.querySelectorAll<HTMLElement>('.yl').forEach((line) => {
			line.style.animation = 'none';
			void line.offsetWidth;
			line.style.animation = '';
		});
	}

	function showMap(root: HTMLElement, index: number) {
		root.querySelectorAll<HTMLButtonElement>('[data-map-btn]').forEach((btn) => {
			const on = Number(btn.dataset.mapBtn) === index;
			btn.classList.toggle('is-on', on);
			btn.setAttribute('aria-pressed', on ? 'true' : 'false');
		});
		root.querySelectorAll<HTMLElement>('[data-map-panel]').forEach((panel) => {
			const on = Number(panel.dataset.mapPanel) === index;
			panel.hidden = !on;
			if (on) replayYaml(panel);
		});
	}

	function boot(root: HTMLElement) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const lastLayer = root.querySelectorAll('[data-slab]').length - 1;
		let layer = lastLayer;
		let timer = 0;
		paint(root, layer);

		const setLayer = (next: number) => {
			window.clearTimeout(timer);
			layer = next;
			paint(root, layer);
		};

		const build = () => {
			window.clearTimeout(timer);
			if (reduced) {
				setLayer(lastLayer);
				return;
			}
			let step = 0;
			setLayer(0);
			const tick = () => {
				step += 1;
				layer = step;
				paint(root, layer);
				if (step < lastLayer) timer = window.setTimeout(tick, 750);
			};
			timer = window.setTimeout(tick, 850);
		};

		root.querySelector<HTMLButtonElement>('[data-build]')?.addEventListener('click', build);
		root.querySelectorAll<HTMLButtonElement>('[data-slab]').forEach((btn) => {
			btn.addEventListener('click', () => setLayer(Number(btn.dataset.slab)));
		});
		root.querySelectorAll<HTMLButtonElement>('[data-map-btn]').forEach((btn) => {
			btn.addEventListener('click', () => showMap(root, Number(btn.dataset.mapBtn)));
		});

		const details = root.querySelector('details');
		details?.addEventListener('toggle', () => {
			if (details.open) build();
		});
	}

	document.querySelectorAll<HTMLElement>('[data-tech]').forEach(boot);
</script>
