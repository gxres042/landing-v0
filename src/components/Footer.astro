---
import copy from '../data/landing.json';
import Icon from './Icon.astro';
import { localizePath, type Locale } from '../i18n';
interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
---
<footer class="wrap flex flex-wrap items-center justify-between gap-5 py-8 md:py-10">
  <a href={localizePath('/', lang)} aria-label={copy[lang].footer.home} class="inline-flex min-h-11 items-center"><img src="/brand/wordmark.svg" alt="engawa" width="144" height="26" class="h-[26px] w-auto" /></a>
  <p class="text-[13px] leading-5 text-muted">{copy[lang].footer.line}</p>
  <a href={localizePath('/rss.xml', lang)} class="inline-flex min-h-11 items-center gap-2 font-mono text-xs text-muted underline-offset-4 hover:underline"><Icon name="rss" /> RSS <Icon name="arrow-up-right" /></a>
</footer>
