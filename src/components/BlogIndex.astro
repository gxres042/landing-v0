---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import { blogCopy, languageTags, localizePath, postLocale, postOrder, postPath, postSlug, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = blogCopy[lang];
const description = t.description;
const posts = (await getCollection('blog', post => postLocale(post.id) === lang))
	.sort((a, b) => postOrder.indexOf(postSlug(a.id)) - postOrder.indexOf(postSlug(b.id)));
---

<!doctype html>
<html lang={languageTags[lang]}>
	<head>
		<BaseHead title={`${t.title} — engawa`} description={description} lang={lang} />
	</head>
	<body>
		<Header lang={lang} />
		<main id="main" class="wrap pb-24 pt-20 sm:pb-32 sm:pt-28">
			<header class="mb-14 flex flex-col gap-8 sm:mb-20 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="eyebrow mb-6">{t.journal}</p>
					<h1 class="heading-xl text-ink">{t.title}<span class="text-lime">.</span></h1>
					<p class="lede mt-6 max-w-xl">{description}</p>
				</div>
				<a class="button button-outline shrink-0 self-start" href={localizePath('/rss.xml', lang)}>
					<Icon name="rss" />
					{t.subscribe} <Icon name="arrow-up-right" />
				</a>
			</header>
			<section aria-label={t.all}>
				<div class="mb-4 flex items-center justify-between font-mono text-xs uppercase tracking-widest text-muted">
					<h2>{t.all}</h2>
					<span>{String(posts.length).padStart(2, '0')} {t.entries}</span>
				</div>
				<ol class="m-0 list-none border-t border-line p-0">
					{posts.map((post, index) => (
						<li class="border-b border-line">
							<a class="group grid gap-5 py-8 transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink sm:grid-cols-[3rem_1fr_auto] sm:gap-8 sm:py-10" href={postPath(post.id)}>
								<span class="pt-1 font-mono text-xs text-muted" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<div>
									<h3 class="text-2xl font-medium leading-tight tracking-tight text-ink sm:text-3xl">{post.data.title}</h3>
									<p class="mt-3 max-w-2xl text-base leading-relaxed text-body">{post.data.description}</p>
									<p class="mt-5 font-mono text-xs text-muted"><FormattedDate date={post.data.pubDate} lang={lang} /></p>
								</div>
								<span class="flex size-10 items-center justify-center rounded-full border border-line text-ink transition-colors group-hover:border-lime group-hover:bg-lime"><Icon name="arrow-up-right" class="size-5" /></span>
							</a>
						</li>
					))}
				</ol>
			</section>
		</main>
		<Footer lang={lang} />
	</body>
</html>
