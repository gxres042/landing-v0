---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { languageTags, locales, localizePath, openGraphLocales, type Locale } from '../i18n';
interface Props { title: string; description: string; image?: ImageMetadata; lang: Locale; type?: 'website' | 'article' }
const { title, description, image, lang, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL(localizePath('/rss.xml', lang), Astro.site)} />
<link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="canonical" href={canonicalURL} />
{locales.map(locale => <link rel="alternate" hreflang={languageTags[locale]} href={new URL(localizePath(Astro.url.pathname, locale), Astro.site)} />)}
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#253326" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={openGraphLocales[lang]} />
{locales.filter(locale => locale !== lang).map(locale => <meta property="og:locale:alternate" content={openGraphLocales[locale]} />)}
{image && <meta property="og:image" content={new URL(image.src, canonicalURL)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
