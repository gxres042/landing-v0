---
import copy from '../data/landing.json';

interface Props { lang?: 'zh' | 'en' | 'zh-cn' }
const { lang = 'zh' } = Astro.props;
const notice = copy[lang].preview;
---
<aside aria-label={notice.label} class="border-b border-ink/15 bg-brand-soft text-ink" data-preview-notice>
  <div class="wrap flex flex-wrap items-center gap-x-3 gap-y-2 py-3 text-sm leading-relaxed">
    <span class="shrink-0 rounded-md border border-ink/20 px-2 py-0.5 font-mono text-xs font-semibold">{notice.label}</span>
    <p class="min-w-0 flex-[1_1_24rem]">{notice.message}</p>
  </div>
</aside>
