---
import { languageTags, type Locale } from '../i18n';
interface Props {
	date: Date;
	lang?: Locale;
}

const { date, lang = 'zh' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(languageTags[lang], {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})}
</time>
