---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Landing from '../components/Landing.astro';
import copy from '../data/landing.json';
import PreviewNotice from '../components/PreviewNotice.astro';
import { languageTags } from '../i18n';

const t = copy.zh;
---

<!doctype html>
<html lang={languageTags.zh}>
	<head>
		<BaseHead title="engawa" description={t.hero.sub} lang="zh" />
	</head>
	<body>
		<PreviewNotice lang="zh" />
		<Header lang="zh" />
		<main id="main">
			<Landing lang="zh" />
		</main>
		<Footer lang="zh" />
	</body>
</html>
